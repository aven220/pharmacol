# ─── PharmaCol — SERVIDOR (convive con otras apps en el mismo host) ─────────
# Ejemplo: PharmaCol en https://TU-IP/pharmacol/ junto a otras aplicaciones

PHARMACOL_SERVER_IP=20.5.19.8
PHARMACOL_BASE_PATH=/pharmacol
PHARMACOL_DOMAIN=20.5.19.8
PHARMACOL_HOST=20.5.19.8
PHARMACOL_PUBLIC_URL="https://20.5.19.8/pharmacol"
PHARMACOL_API="https://20.5.19.8/pharmacol/v1"
PHARMACOL_API_LOCAL="http://127.0.0.1:3906/pharmacol/v1"

# Puertos internos del host (no chocan con 4000, 4401, 8080 típicos)
API_PORT=3905
PHARMACOL_HTTP_PORT=3906
ADMIN_PORT=3907
POSTGRES_HOST_PORT=5543
REDIS_HOST_PORT=6391

VITE_API_URL="/pharmacol/v1"
VITE_BASE_PATH="/pharmacol/"
PHARMACOL_NGINX_CONF=web-subpath.conf

POSTGRES_PASSWORD=cambiar-password-seguro
DATABASE_URL="postgresql://pharmacol:cambiar-password-seguro@127.0.0.1:5543/pharmacol?schema=public"
REDIS_URL="redis://127.0.0.1:6391"

JWT_ACCESS_SECRET="cambiar-access-secret-minimo-32-caracteres"
JWT_REFRESH_SECRET="cambiar-refresh-secret-minimo-32-caracteres"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

OPENAI_API_KEY=""
INVIMA_APP_TOKEN=""
SYNC_CRON_CUM="0 3 * * *"
SYNC_CRON_DM="0 4 * * *"
SYNC_CRON_ALERTAS="0 5 * * *"
SYNC_CRON_ALERTAS_PORTAL="0 7,11,15,19 * * *"
INVIMA_PORTAL_MAX_PAGES="25"
INVIMA_PORTAL_LOOKBACK_DAYS="120"

S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="pharmacol-images"
AES_ENCRYPTION_KEY="cambiar-aes-key-32-caracteres!!"

NODE_ENV=production
CORS_ORIGINS="*"
