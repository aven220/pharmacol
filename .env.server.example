# ─── PharmaCol — SERVIDOR Windows / red local ───────────────────────────────
# IP del servidor: 192.168.20.26
# Uso: copy .env.server.example .env  (o dejar que deploy-windows-server.ps1 lo cree)

PHARMACOL_SERVER_IP=192.168.20.26
PHARMACOL_BASE_PATH=/pharmacol
PHARMACOL_DOMAIN=192.168.20.26
PHARMACOL_HOST=192.168.20.26
PHARMACOL_PUBLIC_URL="http://192.168.20.26:3906/pharmacol"
PHARMACOL_API="http://192.168.20.26:3906/pharmacol/v1"
PHARMACOL_API_LOCAL="http://127.0.0.1:3906/pharmacol/v1"

# 0.0.0.0 = accesible en la red local (LAN). Usa 127.0.0.1 solo si hay proxy delante.
PHARMACOL_HTTP_BIND=0.0.0.0
PHARMACOL_HTTP_PORT=3906

# Puertos internos (no chocan con 4000, 4401, 8080…)
API_PORT=3905
ADMIN_PORT=3907
POSTGRES_HOST_PORT=5543
REDIS_HOST_PORT=6391

VITE_API_URL="/pharmacol/v1"
VITE_BASE_PATH="/pharmacol/"
PHARMACOL_NGINX_CONF=web-subpath.conf

# ⚠️ Cambia en producción real. Debe coincidir en POSTGRES_PASSWORD y DATABASE_URL.
POSTGRES_PASSWORD=PharmaCol_Dev_2026!
DATABASE_URL="postgresql://pharmacol:PharmaCol_Dev_2026!@127.0.0.1:5543/pharmacol?schema=public"
REDIS_URL="redis://127.0.0.1:6391"

JWT_ACCESS_SECRET="pharmacol-jwt-access-secret-min-32-chars"
JWT_REFRESH_SECRET="pharmacol-jwt-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

SEED_ADMIN_EMAIL=admin@pharmacol.co
SEED_ADMIN_PASSWORD=admin123

OPENAI_API_KEY=""
INVIMA_APP_TOKEN=""
SYNC_CRON_CUM="0 3 * * *"
SYNC_CRON_DM="0 4 * * *"
SYNC_CRON_ALERTAS="0 5 * * *"
SYNC_CRON_ALERTAS_PORTAL="0 7,11,15,19 * * *"
INVIMA_PORTAL_MAX_PAGES="25"
INVIMA_PORTAL_LOOKBACK_DAYS="120"

S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="pharmacol-images"
AES_ENCRYPTION_KEY="pharmacol-aes-encryption-key-32ch!"

NODE_ENV=production
CORS_ORIGINS="*"
