# Seed inicial (admin, roles, fuentes INVIMA)
FROM node:20-alpine
RUN apk add --no-cache bash openssl libc6-compat
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY database ./database

ENV npm_config_supported_architectures_os=linux \
    npm_config_supported_architectures_cpu=x64 \
    npm_config_supported_architectures_libc=musl

RUN pnpm install --frozen-lockfile --filter @pharmacol/database...

WORKDIR /app/database
RUN pnpm exec prisma generate

CMD ["pnpm", "exec", "tsx", "prisma/seed.ts"]
