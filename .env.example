# ─── Plantilla .env — DESARROLLO LOCAL (Mac) ────────────────────────────────
# En el servidor usa: cp .env.server.example .env

# ─── Puertos (poco usados — evitan conflictos con 4000, 4401, 8080, etc.) ───
API_PORT=3905
ADMIN_PORT=3907
POSTGRES_HOST_PORT=5543
REDIS_HOST_PORT=6391

POSTGRES_PASSWORD=pharmacol_dev
DATABASE_URL="postgresql://pharmacol:pharmacol_dev@localhost:5543/pharmacol?schema=public"
REDIS_URL="redis://localhost:6391"

JWT_ACCESS_SECRET="cambiar-access-secret-minimo-32-caracteres"
JWT_REFRESH_SECRET="cambiar-refresh-secret-minimo-32-caracteres"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

OPENAI_API_KEY=""
INVIMA_APP_TOKEN=""
SYNC_CRON_CUM="0 3 * * *"
SYNC_CRON_DM="0 4 * * *"
SYNC_CRON_ALERTAS="0 5 * * *"
SYNC_CRON_ALERTAS_PORTAL="0 7,11,15,19 * * *"
INVIMA_PORTAL_MAX_PAGES="25"
INVIMA_PORTAL_LOOKBACK_DAYS="120"

S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="pharmacol-images"
AES_ENCRYPTION_KEY="cambiar-aes-key-32-caracteres!!"

NODE_ENV="development"

# Dev local — admin Vite hace proxy a la API
PHARMACOL_API="http://localhost:3905/v1"
VITE_API_URL="/v1"
